# Copy to local.env (git-ignored) and fill in. deck.mjs and pad.sh read it;
# variables already set in the environment win.
DECK=deck@<deck-ip>
# Optional fallback addresses, tried after DECK. All must name the same Deck.
DECK_HOSTS=deck@<wifi-ip>,deck@<ethernet-ip>
# Optional: Wake-on-LAN for `deck.mjs up` (the adapter's MAC, the LAN broadcast).
DECK_WOL_MAC=
DECK_WOL_BROADCAST=
# Local forwards: scripts and optional MCP. Use different ports per device.
DECK_UI_PORT=18080
DECK_MCP_PORT=9222
DECK_TEST_TARGET=deck
